{
  "name": "decision-server",
  "version": "0.1.0",
  "description": "Jev-compatible decision endpoint: free Workers AI Clef first, Jev fallback. REST + remote MCP.",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "cf dev",
    "deploy": "cf deploy",
    "typecheck": "cf workers types && tsc --noEmit",
    "type-check": "tsc --noEmit",
    "db:migrate": "cf d1 migrations apply \"$DECISIONS_DB_ID\"",
    "db:migrate:local": "cf d1 migrations apply 4e152711-4afd-4482-868c-b98df3e6ef35 --local --dir migrations",
    "test": "vitest",
    "test:run": "vitest run",
    "replay": "bun scripts/replay.ts",
    "preview": "cf previews deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.20.1",
    "hono": "^4.12.17",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-67fa336fd",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "cf": "1.0.0-beta.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
